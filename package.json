{
  "name": "totjo-holocron-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://indubitablyodin.github.io/totjo-holocron-v2",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base=/totjo-holocron-v2/",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-tests.mjs",
    "test:e2e": "playwright test",
    "import:sermons": "node scripts/import-totjo/import-sermons.mjs --archive-url https://templeofthejediorder.org/sermons --output-dir public/imports/totjo-sermons",
    "check:announcements": "node scripts/check-announcements-feed.mjs",
    "check:theme-contrast": "node scripts/check-theme-contrast.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "dexie": "^4.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.7",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-window": "^7.3.0",
    "gh-pages": "^6.1.0"
  }
}
